<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In</title>
  <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-9/assets/css/login-9.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Rubik+Mono+One&display=swap');
    body{
      font-family: "Poppins", system-ui;
      font-weight: 400;
      font-style: normal;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    .content {
      flex-grow: 1; /* This allows the content to grow and push the footer to the bottom */
    }
    .text-logo {
      font-family: "Rubik Mono One", monospace;
      font-size: 50px;
      font-weight: 400;
      font-style: normal;
    }
    section{
      background-color: rgb(0, 30, 43);
    }
    .main-row{
      min-height: 70vh;
    }
    .intro{
      color: rgb(255, 255, 255);
    }
    .card-body{
      background-color:rgb(255, 255, 255);
      border-radius: 20px;
    }
    a{
      text-decoration: none;
    }
    a:hover{
      text-decoration:underline
    }
    .btn-login{
      background-color: rgb(0, 230, 100 );
      font-weight: 500;
    }
    .btn-login:hover{
      background-color: rgb(0, 230, 100 );
      border-color: black;
    }
    footer {
      background-color: transparent;
      padding: 1rem;
      text-align: center;
    }
  </style>
</head>
<body>
<section class="py-5 py-md-5 py-xl-8">
  <div class="container">
    <div class="main-row row gy-4 align-items-center">
      <div class="col-12 col-md-6 col-xl-7">
        <div class="d-flex justify-content-center">
          <div class="intro col-12 col-xl-9">
            <div class="text-logo" style="color: rgb(0, 230, 100)">koka POS</div>
            <hr class="border-primary-subtle mb-4">
            <h2 class="h1 mb-4">Welcome! to koka POS</h2>
            <p class="lead mb-5">Simplify your retail operations with our modern POS system, now with kiosk functionality for with a self-service experience. Manage sales, inventory, and customer interactions effortlessly, all in one intuitive platform.</p>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-xl-5">
        <div class="card border-0 rounded-4">
          <div class="card-body p-3 p-md-4 p-xl-5">
            <div class="row">
              <div class="col-12">
                <div class="mb-4">
                  <h3>Sign In</h3>
                  <!-- Success message -->
                  <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                      <%= success_msg %>
                      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                  <% } %>
                  <!-- Error message -->
                  <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                      <%= error_msg %>
                      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
            <form action="/login" method="POST">
              <div class="row gy-3 overflow-hidden">
                <div class="col-12">
                    <div class="mb-3">
                        <label class="">Username</label>
                        <input name="username" id="username" type="text" class="form-control">
                    </div>
                </div>
                <div class="col-12">
                  <label for="">Password</label>
                  <div class="input-group mb-3">
                    <input id="staff-password" name="staffPassword" type="password" class="form-control">
                    <span class="input-group-text" id="passEye">
                      <a class="pe-auto link-success" href="javascript:void(0);">
                        <i id="js-eyeicon" class="js-password bi bi-eye-slash-fill"></i>
                      </a>
                    </span>
                  </div>
                </div>
                <div class="col-12 mt-5">
                  <div class="d-grid">
                    <button class="btn-login btn btn-lg" type="submit">Log In</button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
</body>
</html>

<script>
document.addEventListener('DOMContentLoaded', () => {
  function togglePasswordVisibility(inputId, iconId) {
    let inputField = document.getElementById(inputId);
    let iconElement = document.getElementById(iconId);
  
    // Check if the elements exist before proceeding
    if (inputField && iconElement) {
      // Attach event listener to the <a> or <span>, not <i>
      iconElement.addEventListener("click", () => {
        let icon = iconElement.querySelector('i');
        if (inputField.type === "password") {
          inputField.type = "text";
          icon.classList.remove("bi-eye-slash-fill");
          icon.classList.add("bi-eye-fill");
        } else {
          inputField.type = "password";
          icon.classList.remove("bi-eye-fill");
          icon.classList.add("bi-eye-slash-fill");
        }
      });
    }
  }

  // Corrected ID for input field
  togglePasswordVisibility('staff-password', 'passEye');
});
</script>