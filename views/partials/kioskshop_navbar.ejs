<!-- Order Summary Modal -->
<div class="modal fade" id="orderSummary" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen" style="background-color: transparent;">
    <div class="modal-content h-100 mb-5" style="background-color: transparent;">
      <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
          <div class="col-12">
            <div class="card shadow" style="border-radius: 15px;">
              <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="card-body p-0">
                <div class="row g-0">
                  <div class="col-lg-8">
                    <div class="p-5">
                      <div class="d-flex justify-content-between align-items-center mb-5">
                        <h1 class="fw-bold mb-0">Order Summary</h1>
                      </div>
                      <hr class="my-2">
                      <div class="order-summary">
                        <!-- Order items will be inserted here dynamically by JavaScript -->
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-4 mb-5">
                    <div class="p-5">
                      <h3 class="fw-bold mb-5 mt-2 pt-1">Order Total</h3>
                      <hr class="my-4">
                      <input id="customer-name" type="text" class="customer-name form-control mb-3" placeholder="Customer Name" />
                      <div class="mb-4 pb-2">
                        <select class="form-select">
                          <option selected value="Dine In">Dine In</option>
                          <option value="Takeout">Takeout</option>
                        </select>
                      </div>
                      <hr class="my-4">
                      <div class="d-flex justify-content-between mb-5">
                        <h5 class="text-uppercase">Total price</h5>
                        <h5><span class="total-amount">0.00</span></h5>
                      </div>
                      <button type="button" class="btn btn-checkout btn-dark btn-block btn-lg" id="checkOutButton" data-bs-dismiss="modal">
                        Checkout
                      </button>
                      <button type="button" class="btn btn-danger btn-block btn-lg" data-bs-dismiss="modal">
                        Cancel Order
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Payment Options Modal -->
<div class="modal fade" id="paymentOptionsModal" tabindex="-1" aria-labelledby="paymentOptionsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="paymentOptionsModalLabel">Payment Options</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

        <form action="/kiosk-shop/orders" method="POST"  class="d-none">
            <h4><span id="customerName"></span></h4>
            <h5>Order Number: <span id="orderNumber"></span></h5>
            <div id="receiptOrderSummary">
            </div>
            <div id="orderType"></div>
            <h6>Total Amount: ₱<span id="receiptTotalAmount"></span></h6>
        </form>
        
        <p>Choose your payment method:</p>
        <button type="submit" class="btn btn-cashpay btn-outline-primary mb-2" data-bs-dismiss="modal">Cash (Pay at the counter)</button>
        <!-- <button type="button" class="btn btn-onlinepay btn-outline-primary mb-2">Online Payment</button> -->
        <div id="paypal-button-container" data-bs-dismiss="modal" style="display: none;"></div>
         <button type="button" class="btn btn-paypalqr btn-outline-success mb-2">Pay with PayPal QR</button>

      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="returnToOrderSummaryButton" aria-label="Close">Return to Order Summary</button>
      </div>
    </div>
  </div>
</div>

