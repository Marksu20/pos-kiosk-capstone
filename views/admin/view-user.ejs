<div class="container-fluid w-75">
    <div class="row">
  
      <%- include('../partials/admin_sidebar.ejs') %>
  
      <main class="col-md-9 ml-sm-5 col-lg-10 px-md-4 py-4">
        <div class="col-12 col-xl-8 mb-4 mb-lg-0">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="card-title">Update User Details</h5>
            </div>
            <form action="/pos/admin/account/<%= user._id %>?_method=PUT" method="POST">
                <div class="card-body">
                  <div class="input-group mb-3">
                    <span class="input-group-text">Email</span>
                    <input id="email-address" name="emailAddress" value="<%= user.emailAddress %>" type="text" class="form-control" required>
                  </div>
              
                  <div class="input-group mb-3">
                    <span class="input-group-text">Username</span>
                    <input id="display-name" name="displayName" value="<%= user.displayName %>" type="text" class="form-control" required>
                  </div>
              
                  <div class="input-group mb-3">
                    <span class="input-group-text">Role</span>
                    <select id="role" name="role" class="form-select" required>
                      <option value="staff" <%= user.role === 'staff' ? 'selected' : '' %>>Staff</option>
                      <option value="sub-admin" <%= user.role === 'sub-admin' ? 'selected' : '' %>>Sub-admin</option>
                    </select>
                  </div>
                </div>
                
                <div class="card-footer text-start">
                  <button type="submit" class="btn btn-primary px-5">Update</button>
                  <a href="/pos/admin/account" class="btn btn-danger px-5">Cancel</a>
                </div>
              </form>
              
              
          </div>
        </div>
      </main>
    </div>
  </div>
  
  