<main class="col-md-9 ml-sm-auto col-lg-10 px-md-4 py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Logs</a></li>
      <li class="breadcrumb-item active" aria-current="page">Overview</li>
    </ol>
  </nav>
  <h1 class="h2">Logs</h1>
  <div class="row overflow-auto" style="max-height: 480px;">
    <%- include('../partials/admin_sidebar.ejs') %>
    <div class="col-12 col-xl-12 mb-4 mb-lg-0">
      <div class="card">
        <div class="card-header sticky-top bg-light shadow-sm" style:"z-index: 1020">
          <input id="logs-search" class="w-25 form-control form-control-dark" type="text" placeholder="Search..." aria-label="Search">
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table">
                <tbody id="logs-list">
                <% if (logs && logs.length > 0) { %>
                  <% logs.forEach(function(log) { 
                    // Determine badge color and icon based on action
                    let badgeClass = "bg-secondary";
                    let icon = "";
                    if (log.action === "delete") {
                      badgeClass = "bg-danger";
                      icon = '<i class="bi bi-trash"></i>';
                    } else if (log.action === "create") {
                      badgeClass = "bg-primary";
                      icon = '<i class="bi bi-plus-circle"></i>';
                    } else if (log.action && log.action.startsWith("update")) {
                      badgeClass = "bg-warning";
                      icon = '<i class="bi bi-pencil-square"></i>';
                    }
                    // Highlight product name and user in the message
                    let highlightedMsg = log.message
                      .replace(
                        /item ([^ ]+)/i, 
                        (match, p1) => `item <span class="text-info fw-bold">${p1}</span>`
                      )
                      .replace(
                        /Update ([^ ]+)/i, 
                        (match, p1) => `Update <span class="text-info fw-bold">${p1}</span>`
                      )
                      .replace(
                        /by ([^:]+):/, 
                        (match, p1) => `by <span class="text-success fw-bold">${p1}</span>:`
                      );
                  %>
                    <tr>
                      <td>
                        <div class="d-flex align-items-center mb-2">
                          <span class="badge <%= badgeClass %> me-2" style="width: 14px; height: 14px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <%- icon %>
                          </span>
                          <span style="font-weight: 500;"><%- highlightedMsg %></span>
                        </div>
                        <div style="color: #aaa; font-size: 0.95em;">
                          <%= log.formattedDate || (new Date(log.timestamp)).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td class="text-center text-muted">No logs found.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
