<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin_sidebar.ejs') %>

    <main class="col-md-9 ml-sm-auto col-lg-10 px-md-4 py-4">
      
      <!-- User Table Section -->
      <div class="container mt-5">
        <div>
          <h2>Manage Users</h2>
        </div>
        <div class="d-flex justify-content-start mb-1">
          <div class="dropdown">
            <select id="roleFilter" class="form-select" aria-label="Filter by role">
              <option value="All Users" <%= selectedRole === 'All Users' ? 'selected' : '' %>>All Users</option>
              <option value="sub-admin" <%= selectedRole === 'sub-admin' ? 'selected' : '' %>>Sub-Admin</option>
              <option value="staff" <%= selectedRole === 'staff' ? 'selected' : '' %>>Staff</option>
            </select>
          </div>

          <div class="mx-2">
            <a href="/add-user-details" class="btn btn-primary px-3">
              + Create User
            </a>
          </div>

        </div>
        
        <div class="card">   
          <div class="card-header d-flex">
            <input id="user-search" class="w-25 form-control form-control-dark" type="text" placeholder="Search..." aria-label="Search">
          </div>
          
          <div class="card-body">
            <!-- Success message -->
            <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>
            <!-- Error message -->
            <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>
            <!-- Table -->
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th scope="col">Email</th>
                    <th scope="col">Username</th>
                    <th scope="col">Role</th>
                    <th scope="col">Date Added</th>
                    <th scope="col">User Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (users && users.length > 0) { %>
                    <% users.forEach(user => { %>
                      <tr class="user-row">
                        <td><%= user.emailAddress %></td>
                        <td><%= user.displayName %></td>
                        <td><%= user.role %></td>
                        <td><%= user.createdAt.toLocaleString() %></td>
                        <td>
                          <a href="/pos/admin/account/<%= user._id %>" class="btn btn-sm btn-primary">Edit</a>
                          <a class="btn btn-sm btn-danger btn-delete-user"
                            data-user-id="<%= user._id %>"
                            data-user-emailAddress="<%= user.emailAddress %>"
                            data-user-name="<%= user.displayName %>"
                            data-user-role="<%= user.role %>"
                            data-bs-toggle="modal" data-bs-target="#deleteUserModal"
                            >Delete
                          </a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center text-danger">No user(s) found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
              <div id="no-results" class="text-center" style="display: none;">
                No results found.
              </div>
            </div>
          </div>
        </div>
      </div>
      
       <!-- Account Kiosk Section -->
       <div class="container mt-5">
        <div class="card text-center">
          <div class="card-header">
            <h4>Account Kiosk</h4>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-12">
                <a id="kioskLink" target="_blank"></a>
                <div id="qrcode" class="mt-3 mb-5">
                  <!-- QR Code -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- User Account Information Section -->
      <div class="container mt-5">
        <div class="card">
          <div class="card-header">
            <h4>Admin Account Information</h4>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-4 text-center">
                <img src="<%= profileimage ? profileimage : '/img/user.jpg' %>" 
                  class="rounded-circle img-thumbnail img-fluid" 
                  alt="User Avatar" style="width: 150px ; max-width: 200px; height: auto;">
              </div>
              <div class="col-md-8">
                <h5 class="card-title mb-4"><%= displayname %></h5>
                <p class="card-text"><strong>Email:</strong> <%= emailaddress %></p>
                <p class="card-text"><strong>Company Name:</strong> <%= companyname %></p>
              </div>
            </div>
          </div>
          <div class="card-footer text-muted text-center">
            <!-- <button class="btn btn-primary w-25" data-bs-toggle="modal" data-bs-target="#accountModal">
              Edit
            </button> -->
          </div>
        </div>
      </div>  
    </main>
  </div>
</div>

<!-- Update Account Modal -->
<div class="modal fade" id="accountModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Update Account</h5>
      </div>
      <form id="updateAccountForm" method="POST">
        <div class="modal-body">

          <div id="error-message" class="alert alert-danger d-none"></div>
          <div id="success-message" class="alert alert-success d-none"></div>
          
          <div class="input-group mb-3">
            <span class="input-group-text">New Company Name</span>
            <input id="companyname" name="companyName" value="<%= companyname %>" type="text" class="form-control">
          </div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-primary">Update</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- delete modal -->
<div class="modal" id="deleteUserModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      
      <div class="modal-header">
        <h5 class="modal-title">
          You are about to delete a <b class="fw-bold text-warning" id="modal-user-role"></b>
        </h5>
      </div>
      
      <div class="modal-body">
        <p>
          This will delete the user <b class="fw-bold text-danger" id="modal-user-emailAddress"></b><br/>
          with username '<strong id="modal-user-name">user_name</strong>'.  Are you sure?
        </p>
      </div>

      <!-- footer -->
      <form id="delete-user-form">
        <input type="hidden" id="delete-user-id" name="userId" />
        <div class="modal-footer">
          <button type="submit" class="btn btn-danger">Delete</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>  
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<!-- generate qr code --> 
<script>
  function generateKioskDetails() {
    const userId = "<%= user %>";
    const kioskPath = `/${userId}/kiosk`; // Update this with your actual kiosk path
    const baseUrl =" http://localhost:5000";
    const kioskUrl = `${baseUrl}${kioskPath}`;

    // Set the kiosk link
    const kioskLinkElement = document.getElementById("kioskLink");
    kioskLinkElement.href = kioskUrl;
    kioskLinkElement.textContent = kioskUrl;

    const qrCodeElement = document.getElementById("qrcode");
    new QRCode(qrCodeElement, {
      text: kioskUrl,
      width: 200,
      height: 200,
    });
  }
  // Call the function to generate the details when the page loads
  window.onload = generateKioskDetails;
</script>

<script>
document.getElementById('updateAccountForm').addEventListener('submit', async function(event) {
  event.preventDefault(); // Prevent default form submission

  const form = event.target;
  const formData = new FormData(form);
  
  // Convert FormData to a JSON object
  const formObj = {};
  formData.forEach((value, key) => {
    formObj[key] = value;
  });

  const url = `/pos/admin/account/<%= accountID %>?_method=PUT`;

  // Hide previous messages
  document.getElementById('error-message').classList.add('d-none');
  document.getElementById('success-message').classList.add('d-none');
  
  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(formObj)
    });

    const result = await response.json();

    if (result.success) {
      // Show success message
      const successMessage = document.getElementById('success-message');
      successMessage.innerHTML = result.message;
      successMessage.classList.remove('d-none');
    } else {
      // Show error message
      const errorMessage = document.getElementById('error-message');
      errorMessage.innerHTML = result.message;
      errorMessage.classList.remove('d-none');
    }
  } catch (error) {
    // Handle fetch error
    const errorMessage = document.getElementById('error-message');
    errorMessage.innerHTML = 'An unexpected error occurred. Please try again.';
    errorMessage.classList.remove('d-none');
  }
});
document.getElementById('accountModal').addEventListener('hidden.bs.modal', function () {
  location.reload();
});
</script>

<!-- FILTER USER -->
<script>
  document.getElementById('roleFilter').addEventListener('change', function () {
    const selectedRole = this.value;
    const url = new URL(window.location.href);
    url.searchParams.set('role', selectedRole); // Update the query parameter
    window.location.href = url; // Redirect with the updated query
  });
</script>

<!-- search function -->
<script>
  document.getElementById('user-search').addEventListener('input', function () {
    const searchQuery = this.value.toLowerCase();
    const userRows = document.querySelectorAll('.user-row');
    let hasResults = false;

    userRows.forEach(row => {
      const userEmail = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
      const username = row.querySelector('td:nth-child(2)').textContent.toLowerCase();

      if (userEmail.includes(searchQuery) || username.includes(searchQuery)) {
        row.style.display = '';
        hasResults = true;
      } else {
        row.style.display = 'none';
      }
    });
    // Show "No results" message if no rows match the search query
    document.getElementById('no-results').style.display = hasResults ? 'none' : 'block';
  })
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const deleteButtons = document.querySelectorAll('.btn-delete-user');
    const deleteForm = document.getElementById('delete-user-form');
    const modalElement = document.getElementById('deleteUserModal');
  
    deleteButtons.forEach(button => {
      button.addEventListener('click', function() {
        const userId = this.getAttribute('data-user-id');
        const emailAddress = this.getAttribute('data-user-emailAddress');
        const userName = this.getAttribute('data-user-name');
        const userRole = this.getAttribute('data-user-role');

        // Set the modal text with the receipt number and customer name
        document.getElementById('modal-user-emailAddress').textContent = emailAddress;
        document.getElementById('modal-user-name').textContent = userName;
        document.getElementById('modal-user-role').textContent = userRole;
  
        // Set the form's hidden input with the receipt ID for deletion
        document.getElementById('delete-user-id').value = userId;
      });
    });
  
    deleteForm.addEventListener('submit', function(event) {
      event.preventDefault();
  
      const userId = document.getElementById('delete-user-id').value;
  
      fetch(`/delete-user/${userId}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(response => {
        if (!response.ok) {
          throw new Error(`Server error: ${response.statusText}`);
        }
  
        return response.json();
      })
      .then(data => {
        if (data.success) {
          // Refresh the page after successful deletion
          window.location.reload();
        } else {
          alert('Error deleting the receipt.');
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
      });
    });
  });
</script>






