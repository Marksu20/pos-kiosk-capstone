          .receipt-details p { margin: 5px 0; }
          .receipt-footer { text-align: center; margin-top: 20px; }
          .receipt-footer p { margin: 5px 0; }
          @media print {
            .modal-footer, .close-btn { display: none; }
          }
        </style>
      </head>
      <body>
        <div class="receipt-container">
          <div class="receipt-header">
            <h2>Order Summary</h2>
          </div>
          <div class="receipt-details">
            <h4><span id="customerName"></span></h4>
            <h5>Order Number: #<span id="orderNumber"></span></h5>
            <div id="receiptOrderSummary"></div>
            <hr>
            <div class="d-flex justify-content-between">
              <div id="orderType"></div>
              <div id="createdAt"></div>
            </div>
            <div id="discountContainer">
              <p>Discount: <span id="discount"></span></p>
            </div>
            <div class="d-flex justify-content-between">
              <h6>Total Amount: ₱<span id="receiptTotalAmount"></span></h6>
              <h6>Cashier: <span id="cashier"></span></h6>
            </div>
          </div>
          <div class="receipt-footer">
            <p>Thank you for your purchase!</p>
          </div>
        </div>
      </body>
    </html>
  `);

  // Copy the content from the modal to the print window
  printWindow.document.getElementById('customerName').textContent = document.getElementById('customerName').textContent;
  printWindow.document.getElementById('orderNumber').textContent = document.getElementById('orderNumber').textContent;
  printWindow.document.getElementById('receiptOrderSummary').innerHTML = document.getElementById('receiptOrderSummary').innerHTML;
  printWindow.document.getElementById('orderType').textContent = document.getElementById('orderType').textContent;
  printWindow.document.getElementById('createdAt').textContent = document.getElementById('createdAt').textContent;
  printWindow.document.getElementById('discount').textContent = document.getElementById('discount').textContent;
  printWindow.document.getElementById('receiptTotalAmount').textContent = document.getElementById('receiptTotalAmount').textContent;
  printWindow.document.getElementById('cashier').textContent = document.getElementById('cashier').textContent;

  // Trigger the print dialog
  printWindow.document.close();
  printWindow.print();
});
</script>

<!-- delete modal -->
<div class="modal" id="deleteReceiptModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      
      <div class="modal-header">
        <h5 class="modal-title">
          You are about to delete a receipt
        </h5>
      </div>
      
      <div class="modal-body">
        <p>
          This will delete your Receipt <b class="fw-bold text-danger" id="modal-receipt-number"></b><br/>
          for <strong id="modal-customer-name">customer_name</strong>  Are you sure?
        </p>
      </div>

      <!-- footer -->
      <form id="delete-receipt-form">
        <input type="hidden" id="delete-receipt-id" name="receiptId" />
        <div class="modal-footer">
          <button type="submit" class="btn btn-danger">Delete</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>  
        </div>
      </form>
    </div>
  </div>
</div>

<!-- delete receipt function -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const deleteButtons = document.querySelectorAll('.btn-delete-receipt');
  const deleteForm = document.getElementById('delete-receipt-form');
  const modalElement = document.getElementById('deleteReceiptModal');

  deleteButtons.forEach(button => {
    button.addEventListener('click', function() {
      const receiptId = this.getAttribute('data-receipt-id');
      const receiptNumber = this.getAttribute('data-receipt-number');
      const customerName = this.getAttribute('data-customer-name');

      // Set the modal text with the receipt number and customer name
      document.getElementById('modal-receipt-number').textContent = `#${receiptNumber}`;
      document.getElementById('modal-customer-name').textContent = customerName;

      // Set the form's hidden input with the receipt ID for deletion
      document.getElementById('delete-receipt-id').value = receiptId;
    });
  });

  deleteForm.addEventListener('submit', function(event) {
    event.preventDefault();

    const receiptId = document.getElementById('delete-receipt-id').value;

    fetch(`/delete-receipt/${receiptId}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`Server error: ${response.statusText}`);
      }

      return response.json();
    })
    .then(data => {
      if (data.success) {
        // Refresh the page after successful deletion
        window.location.reload();
      } else {
        alert('Error deleting the receipt.');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
    });
  });
});
</script>

<!-- search function -->
<script>
  document.getElementById('receipt-search').addEventListener('input', function () {
    const searchQuery = this.value.toLowerCase();
    const receiptRows = document.querySelectorAll('.receipt-row');
    let hasResults = false;

    receiptRows.forEach(row => {
      const orderNumber = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
      const customerName = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
      const orderTotal = row.querySelector('td:nth-child(6)').textContent.toLocaleLowerCase();
      
      if (orderNumber.includes(searchQuery) || customerName.includes(searchQuery) || orderTotal.includes(searchQuery)) {
        row.style.display = '';
        hasResults = true;
      } else {
        row.style.display = 'none';
      }
    });

    // Show "No results" message if no rows match the search query
    document.getElementById('no-results').style.display = hasResults ? 'none' : 'block';
  });
</script>




