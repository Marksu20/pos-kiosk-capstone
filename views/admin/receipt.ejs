<main class="col-md-9 ml-sm-auto col-lg-10 px-md-4 py-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/receipts.html">Receipts</a></li>
      <li class="breadcrumb-item active" aria-current="page">Overview</li>
    </ol>
  </nav>
  <h1 class="h2">Receipts</h1>
  <div class="row overflow-auto" style="max-height: 480px;">
    <%- include('../partials/admin_sidebar.ejs') %>
    <div class="col-12 col-xl-12 mb-4 mb-lg-0">
      <div class="card">
        <div class="card-header sticky-top bg-light shadow-sm" style:"z-index: 1020">
          <input id="receipt-search" class="w-25 form-control form-control-dark" type="text" placeholder="Search..." aria-label="Search">
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Order No.</th>
                  <th scope="col">Customer</th>
                  <th scope="col">Product(s)</th>
                  <th scope="col">Payment</th>
                  <th scope="col">Discount</th>
                  <th scope="col">Total</th>
                  <th scope="col">Cashier</th>
                  <th scope="col">Created</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <% if (receipts.length > 0) { %>
                <% receipts.forEach( receipt => { %>
                  <tbody id="receipt-list">
                    <tr class="receipt-row">
                      <td><strong># <%= receipt.orderNumber %></strong></td>
                      <td><%= receipt.customerName %></td>
                      <td>
                        <% receipt.orderItems.forEach(item => { %>
                          <%= item.name %> -
                          ₱ <%= item.price %> 
                          ( x <%= item.quantity %> ), <br>
                        <% }) %>
                      </td>
                      <td><%= receipt.paymentMethod %></td>
                      <td><%= receipt.discount %> %</td>
                      <td>₱ <%= receipt.totalAmount %></td>
                      <td><%= receipt.cashier %></td>
                      <td><%= new Date( receipt.createdAtLocal ).toLocaleString() %></td>
                      <td>
                        <button class="btn btn-sm btn-primary px-3 view-receipt" data-receipt='<%= JSON.stringify(receipt) %>'>view</button>
                        
                        <button class="btn btn-sm btn-danger btn-delete-receipt" 
                          data-receipt-id="<%= receipt._id %>" 
                          data-receipt-number="<%= receipt.orderNumber %>"
                          data-customer-name="<%= receipt.customerName %>" 
                          data-bs-toggle="modal" data-bs-target="#deleteReceiptModal">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </td>
                    </tr>
                  </tbody>
                <% }) %>
              <% } %>
            </table>
            <div id="no-results" class="text-center" style="display: none;">
              No results found.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<div class="modal fade" id="receipt-modal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Order Receipt</h5>
      </div>
      <div class="modal-body">
        <div class="receipt">
          <h1 class="mb-2">#<span id="orderNumber"></span></h1>
          <div class="line"></div>
          <p class="fw-bold mb-2" id="companyName"></p>
          <div class="d-flex justify-content-between mb-2">
            <p>Customer: <strong id="customerName"></strong></p>
            <p>Cashier: <strong id="cashier"></strong></p>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <p>Payment: <strong id="paymentMethod"></strong></p>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <p>Date: <strong id="createdAt"></strong></p>
            <p>At: <strong id="createdTime"></strong></p>
          </div>
          <div class="line"></div>
          <div id="receiptOrderSummary">
            
          </div>
          <div class="line"></div>

          <div class="d-flex justify-content-between">
            <p>Subtotal:</p>
            <p>₱ <span id="subTotal"></span></p>
          </div>

          <div class="d-flex justify-content-between" id="discountContainer">
            <p>Discount:</p>
            <p><span id="discount"></span></p>
          </div>

          <div class="line"></div>
          <div class="d-flex justify-content-between total">
            <p>Total:</p>
            <p>₱ <span id="receiptTotalAmount"></span></p> 
          </div>
          <div class="footer">
            <p><span id="orderType"></span></p> 
            <p>THANK YOU!</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="print-receipt-btn">Print</button>
        <button type="button" class="btn btn-secondary close-btn" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

