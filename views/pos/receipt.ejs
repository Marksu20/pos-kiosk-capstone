<!-- main content -->
<div class="container-fluid">
  <div class="row">
    <!-- sidebar -->
    <%- include('../partials/pos_sidebar.ejs') %>
    <main class="col-md-10 ml-sm-auto col-lg-10 px-md-4 py-4">
    <h1 class="h2 mb-4">List of Receipts</h1>
    <di class="row overflow-auto" style="max-height: 500px;">
      <div id="receipts" class="col-12 col-xl-12 mb-4 mb-lg-0">
        <div class="card">
          <div class="card-header sticky-top bg-light shadow-sm" style="z-index: 1020;">
            <input id="receipt-search" class="w-25 form-control form-control-dark" type="text" placeholder="Search..." aria-label="Search">
          </div>
          <div id="card-body" class="card-body">
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Order No.</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Product(s)</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Discount</th>
                    <th scope="col">Total</th>
                    <th scope="col">Cashier</th>
                    <th scope="col">Created</th>
                    <th scope="col">Action</th>
                  </tr>
                </thead>
                <% if (receipts.length > 0) { %>
                  <% receipts.forEach( receipt => { %>
                    <tbody id="receipt-list">
                      <tr class="receipt-row">
                        <td><strong># <%= receipt.orderNumber %></strong></td>
                        <td><%= receipt.customerName %></td>
                        <td>
                          <% receipt.orderItems.forEach(item => { %>
                            <%= item.name %> - 
                            ₱ <%= item.price %> 
                            ( x <%= item.quantity %> ), <br> 
                          <% }) %>
                        </td>
                        <td><%= receipt.paymentMethod %></td>
                        <td>% <%= receipt.discount %></td>
                        <td>₱ <%= receipt.totalAmount %></td>
                        <td><%= receipt.cashier %></td>
                        <td><%= new Date( receipt.createdAtLocal ).toLocaleString() %></td>
                        <td>
                          <button class="btn btn-sm btn-primary px-3 view-receipt" data-receipt='<%= JSON.stringify(receipt) %>'>view</button>
                          <!-- <button class="btn btn-sm btn-outline-secondary px-3">print</button> -->
                        </td>
                      </tr>
                    </tbody>
                  <% }) %>
                <% } %>
              </table>
              <div id="no-results" class="text-center" style="display: none;">
                No results found.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </main>
  </div>
</div>

<!-- show receipt modal -->
<div class="modal fade" id="receipt-modal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Order Receipt</h5>
      </div>
      <div class="modal-body">
        <div class="receipt">
          <h1 class="mb-2">#<span id="orderNumber"></span></h1>
          <div class="line"></div>
          <p class="fw-bold mb-2" id="companyName"></p>
          <div class="d-flex justify-content-between mb-2">
            <p>Customer: <strong id="customerName"></strong></p>
            <p>Cashier: <strong id="cashier"></strong></p>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <p>Payment: <strong id="paymentMethod"></strong></p>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <p>Date: <strong id="createdAt"></strong></p>
            <p>At: <strong id="createdTime"></strong></p>
          </div>
          <div class="line"></div>
          <div id="receiptOrderSummary">
            
          </div>
          <div class="line"></div>

          <div class="d-flex justify-content-between">
            <p>Subtotal:</p>
            <p>₱ <span id="subTotal"></span></p>
          </div>

          <div class="d-flex justify-content-between" id="discountContainer">
            <p>Discount:</p>
            <p><span id="discount"></span></p>
          </div>

          <div class="line"></div>
          <div class="d-flex justify-content-between total">
            <p>Total:</p>
            <p>₱ <span id="receiptTotalAmount"></span></p> 
          </div>
          <div class="footer">
            <p><span id="orderType"></span></p> 
            <p>THANK YOU!</p>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-primary" id="print-receipt-btn">Print</button>
        <button type="button" class="btn btn-secondary close-btn" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- show receipt function -->
<script>
  document.querySelectorAll('.view-receipt').forEach(button => {
    button.addEventListener('click', function () {
      const receipt = JSON.parse(this.getAttribute('data-receipt'));
  
      // Populate receipt modal
      document.getElementById('customerName').textContent = receipt.customerName;
      document.getElementById('orderNumber').textContent = receipt.orderNumber;
      document.getElementById('orderType').textContent = receipt.orderType;
      document.getElementById('subTotal').textContent = receipt.subTotal;
      document.getElementById('receiptTotalAmount').textContent = receipt.totalAmount;
      document.getElementById('cashier').textContent = receipt.cashier;
      document.getElementById('companyName').textContent = receipt.companyName;
      document.getElementById('paymentMethod').textContent = receipt.paymentMethod;
  
      // Handle Discount Display
      const discountContainer = document.getElementById('discountContainer');
      if (receipt.discount > 0) {
        document.getElementById('discount').textContent = `%${receipt.discount}`;
        discountContainer.style.display = 'block';
      } else {
        discountContainer.style.display = 'none';
      }
  
      const receiptOrderSummary = receipt.orderItems.map(item => {
        const totalPrice = item.quantity * item.price;
          return `
            <div class="order-item bg-light px-2 mb-2">
              <span>${item.quantity}</span>
              <span>${item.name}</span>
              <p>₱ <span>${totalPrice.toFixed(2)}</span></p>
            </div>
          `;  
        }).join('');

      document.getElementById('receiptOrderSummary').innerHTML = receiptOrderSummary;
  
      const createdAt = new Date(receipt.createdAt);
      const formattedDate = createdAt.toLocaleDateString(); // Customize format if necessary
      const formattedTime = createdAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      document.getElementById('createdAt').textContent = formattedDate;
      document.getElementById('createdTime').textContent = formattedTime;
  
      // Show modal
      const receiptModal = new bootstrap.Modal(document.getElementById('receipt-modal'));
      receiptModal.show();
    });
  });
</script>

<!-- print receipt function -->
<script>
  document.getElementById('print-receipt-btn').addEventListener('click', function () {
    const receiptModalContent = document.getElementById('receipt-modal').innerHTML;
  
    // Create a new window for printing
    const printWindow = window.open('', '', 'height=600,width=800');
    printWindow.document.write(`
      <html>
        <head>
          <title>Print Receipt</title>
          <style>
            body { font-family: Arial, sans-serif; }
            .receipt-container { width: 100%; max-width: 400px; margin: 0 auto; padding: 20px; border: 1px solid #ccc; }
            .receipt-header { text-align: center; margin-bottom: 20px; }
            .receipt-header h2 { margin: 0; }
            .receipt-details { margin-bottom: 20px; }
            .receipt-details p { margin: 5px 0; }
            .receipt-footer { text-align: center; margin-top: 20px; }
            .receipt-footer p { margin: 5px 0; }
            @media print {
              .modal-footer, .close-btn { display: none; }
            }
          </style>
        </head>
        <body>
          <div class="receipt-container">
            <div class="receipt-header">
              <h2>Order Summary</h2>
            </div>
            <div class="receipt-details">
              <h4><span id="customerName"></span></h4>
              <h5>Order Number: #<span id="orderNumber"></span></h5>
              <div id="receiptOrderSummary"></div>
              <hr>
              <div class="d-flex justify-content-between">
                <div id="orderType"></div>
                <div id="createdAt"></div>
              </div>
              <div id="discountContainer">
                <p>Discount: <span id="discount"></span></p>
              </div>
              <div class="d-flex justify-content-between">
                <h6>Total Amount: ₱<span id="receiptTotalAmount"></span></h6>
                <h6>Cashier: <span id="cashier"></span></h6>
              </div>
            </div>
            <div class="receipt-footer">
              <p>Thank you for your purchase!</p>
            </div>
          </div>
        </body>
      </html>
    `);
  
    // Copy the content from the modal to the print window
    printWindow.document.getElementById('customerName').textContent = document.getElementById('customerName').textContent;
    printWindow.document.getElementById('orderNumber').textContent = document.getElementById('orderNumber').textContent;
    printWindow.document.getElementById('receiptOrderSummary').innerHTML = document.getElementById('receiptOrderSummary').innerHTML;
    printWindow.document.getElementById('orderType').textContent = document.getElementById('orderType').textContent;
    printWindow.document.getElementById('createdAt').textContent = document.getElementById('createdAt').textContent;
    printWindow.document.getElementById('discount').textContent = document.getElementById('discount').textContent;
    printWindow.document.getElementById('receiptTotalAmount').textContent = document.getElementById('receiptTotalAmount').textContent;
    printWindow.document.getElementById('cashier').textContent = document.getElementById('cashier').textContent;
  
    // Trigger the print dialog
    printWindow.document.close();
    printWindow.print();
  });
</script>

<!-- search function -->
<script>
  document.getElementById('receipt-search').addEventListener('input', function () {
    const searchQuery = this.value.toLowerCase();
    const receiptRows = document.querySelectorAll('.receipt-row');
    let hasResults = false;

    receiptRows.forEach(row => {
      const orderNumber = row.querySelector('td:nth-child(1)').textContent.toLowerCase();
      const customerName = row.querySelector('td:nth-child(2)').textContent.toLowerCase();
      const totalAmount = row.querySelector('td:nth-child(6)').textContent.toLowerCase();
      
      if (orderNumber.includes(searchQuery) || customerName.includes(searchQuery) || totalAmount.includes(searchQuery)) {
        row.style.display = '';
        hasResults = true;
      } else {
        row.style.display = 'none';
      }
    });

    // Show "No results" message if no rows match the search query
    document.getElementById('no-results').style.display = hasResults ? 'none' : 'block';
  });
</script>


